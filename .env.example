# Upgrade path under test.
FROM_VERSION=v2.48.4
TO_VERSION=v2.50.1

# Stack endpoints (host side).
PROXY_URL=http://127.0.0.1:8080
HAPROXY_STATS_HOST=127.0.0.1
HAPROXY_STATS_PORT=9999
SIDECAR_URL=http://127.0.0.1:8081

# Direct access to each engine, bypassing the proxy. Used by the green pre-flight
# gate, which must verify correctness before any traffic is switched.
BLUE_DIRECT_URL=http://127.0.0.1:8181
GREEN_DIRECT_URL=http://127.0.0.1:8182

HASURA_ADMIN_SECRET=harness-admin-secret

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Harness profile: fast | default | soak
PROFILE=default
POLICY=strict
